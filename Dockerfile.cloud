FROM --platform=linux/arm64 node:24-bookworm-slim AS frontend

WORKDIR /build
COPY frontend/package.json frontend/package-lock.json frontend/tsconfig.json frontend/vite.config.ts ./frontend/
RUN cd frontend && npm ci --no-audit --no-fund
COPY frontend/src ./frontend/src
RUN cd frontend && npm run build

FROM --platform=linux/arm64 python:3.12-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    HOME=/tmp \
    SOFFICE_PATH=/usr/bin/soffice

RUN apt-get update && apt-get install -y --no-install-recommends \
    libreoffice-writer fonts-noto-cjk ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /var/task
COPY pyproject.toml ./
COPY cvbuilder ./cvbuilder
COPY migrations ./migrations
COPY templates ./templates
COPY docs/schemas ./docs/schemas
COPY web ./web
COPY --from=frontend /build/web/static/vue ./web/static/vue
RUN python -m pip install --no-cache-dir . awslambdaric \
    && test -x /usr/bin/soffice \
    && test -f templates/template-01.docx \
    && test -f templates/template-02.docx \
    && test -f templates/template-03.docx \
    && test -f migrations/001_initial_mysql.sql

ENTRYPOINT ["python", "-m", "awslambdaric"]
CMD ["cvbuilder.cloud.handler"]

FROM --platform=linux/arm64 python:3.12-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    HOME=/tmp \
    SOFFICE_PATH=/usr/bin/soffice

RUN apt-get update && apt-get install -y --no-install-recommends \
    libreoffice-writer fonts-noto-cjk ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /var/task
COPY pyproject.toml ./
COPY cvbuilder ./cvbuilder
COPY templates ./templates
COPY docs/schemas ./docs/schemas
COPY web ./web
RUN python -m pip install --no-cache-dir . awslambdaric \
    && test -x /usr/bin/soffice \
    && test -f templates/template-01.docx \
    && test -f templates/template-02.docx \
    && test -f templates/template-03.docx

ENTRYPOINT ["python", "-m", "awslambdaric"]
CMD ["cvbuilder.cloud.handler"]

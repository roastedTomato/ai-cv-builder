{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "base-resume.schema.json",
  "title": "基础简历",
  "type": "object",
  "additionalProperties": false,
  "required": ["resume_id", "version", "personal", "education", "work", "projects", "skills", "certificates"],
  "properties": {
    "fixture_note": {"type": "string", "const": "虚构测试数据，不对应真实个人。"},
    "resume_id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "personal": {"type": "object", "additionalProperties": false, "required": ["name", "email", "phone", "location"], "properties": {"name": {"type": "string"}, "email": {"type": "string"}, "phone": {"type": "string"}, "location": {"type": "string"}, "summary": {"type": "string"}}},
    "education": {"$ref": "#/$defs/educationList"},
    "work": {"$ref": "#/$defs/workList"},
    "projects": {"$ref": "#/$defs/projectList"},
    "skills": {"type": "array", "items": {"$ref": "#/$defs/skill"}},
    "certificates": {"type": "array", "items": {"$ref": "#/$defs/certificate"}}
  },
  "$defs": {
    "education": {"type": "object", "additionalProperties": false, "required": ["id", "school", "degree", "major", "start_date", "end_date", "details"], "properties": {"id": {"type": "string", "minLength": 1}, "school": {"type": "string"}, "degree": {"type": "string"}, "major": {"type": "string"}, "start_date": {"type": "string"}, "end_date": {"type": "string"}, "details": {"type": "array", "items": {"type": "string"}}}},
    "work": {"type": "object", "additionalProperties": false, "required": ["id", "employer", "title", "start_date", "end_date", "description", "achievements"], "properties": {"id": {"type": "string", "minLength": 1}, "employer": {"type": "string"}, "title": {"type": "string"}, "start_date": {"type": "string"}, "end_date": {"type": "string"}, "description": {"type": "string"}, "achievements": {"type": "array", "items": {"type": "string"}}}},
    "project": {"type": "object", "additionalProperties": false, "required": ["id", "name", "role", "start_date", "end_date", "description", "achievements", "technologies"], "properties": {"id": {"type": "string", "minLength": 1}, "name": {"type": "string"}, "role": {"type": "string"}, "start_date": {"type": "string"}, "end_date": {"type": "string"}, "description": {"type": "string"}, "achievements": {"type": "array", "items": {"type": "string"}}, "technologies": {"type": "array", "items": {"type": "string"}}}},
    "skill": {"type": "object", "additionalProperties": false, "required": ["id", "name", "level"], "properties": {"id": {"type": "string", "minLength": 1}, "name": {"type": "string"}, "level": {"type": "string"}}},
    "certificate": {"type": "object", "additionalProperties": false, "required": ["id", "name", "issuer", "date"], "properties": {"id": {"type": "string", "minLength": 1}, "name": {"type": "string"}, "issuer": {"type": "string"}, "date": {"type": "string"}}},
    "educationList": {"type": "array", "items": {"$ref": "#/$defs/education"}},
    "workList": {"type": "array", "items": {"$ref": "#/$defs/work"}},
    "projectList": {"type": "array", "items": {"$ref": "#/$defs/project"}}
  }
}
